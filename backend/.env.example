# 搜索服务，可选 duckduckgo、tavily、perplexity、searxng
SEARCH_API='duckduckgo'

# LLM 配置（LangChain 使用 OpenAI 兼容接口）

# 模型提供者
LLM_PROVIDER=custom          # 可选：ollama、lmstudio、custom；custom 用于自定义 OpenAI 兼容服务
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO
# Web 搜索 API Key（按需配置）
# TAVILY_API_KEY=tvly-xxxxx      # 在 https://tavily.com 获取
# PERPLEXITY_API_KEY=pplx-xxxxx  # 在 https://www.perplexity.ai 获取
# SearXNG 默认使用 http://localhost:8888
# SEARXNG_URL=

# 本地模型配置(LMStudio/Ollama)
# LLM_PROVIDER=lmstudio          # 可选：ollama、lmstudio
# LOCAL_LLM=qwen_qwq-32b         # LMStudio/Ollama 中的模型名称
# LMSTUDIO_BASE_URL=http://localhost:1234/v1  # LMStudio OpenAI 兼容 API 地址
# OLLAMA_BASE_URL=http://localhost:11434 # Ollama 服务地址，未设置时默认使用此地址

MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True

# LangSmith 追踪（可选）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=deep-research

# 数据库 / RAG 配置
# 本地开发可先运行：docker compose up -d db
# 然后在 backend 目录执行：python -m alembic upgrade head
# 未设置 DATABASE_URL 时，后端自动使用内存仓库，不要求 Postgres。
# DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@localhost:5432/deepresearch
RAG_ENABLED=False
RAG_QUERY_REWRITE_ENABLED=True
RAG_MERGE_ADJACENT_CHUNKS=True
RAG_ADJACENT_CHUNK_WINDOW=1
# Embedding 可单独配置，不必复用 LLM；例如 DeepSeek 做聊天、DashScope/Qwen 做 embedding。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=1536
VECTOR_NAMESPACE=deep_research
